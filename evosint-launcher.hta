<!DOCTYPE html>
<html>
<head>
<title>Evosint Launcher</title>
<hta:application
    id="OSINTProLauncher"
    border="dialog"
    caption="yes"
    showInTaskbar="yes"
    singleInstance="yes"
    sysmenu="yes"
    maximizable="no"
    minimizable="yes"
    navigable="no"
    contextMenu="no"
    selection="no"
    innerBorder="no"
/>
<style>
body{font-family:Segoe UI,Arial,sans-serif;background:#0b1220;color:#e6edf7;margin:0;padding:28px;text-align:center}
h2{margin:0 0 6px 0}
p{color:#93a1b8;font-size:13px}
button{background:#6366f1;color:#fff;border:none;padding:10px 22px;border-radius:8px;cursor:pointer;font-size:14px;margin-top:12px}
button:hover{background:#4f46e5}
code{display:block;background:#141f36;padding:10px;margin:12px 0;border-radius:6px;font-size:12px;color:#22d3ee}
#status{margin-top:10px;font-size:13px}
</style>
</head>
<body>
<h2>&#x1F6F0;&#xFE0F; Evosint Launcher</h2>
<p>This helper opens Evosint in your real browser (faster &amp; more compatible than the old embedded view).</p>
<code>http://localhost:3001</code>
<button onclick="openBrowser()">Open Evosint in browser</button>
<div id="status">If nothing opens, start the server first: <b>node launch-osint.js</b> or double-click <b>launch-osint.bat</b></div>
<script type="text/javascript">
function openBrowser() {
    try {
        var shell = new ActiveXObject('WScript.Shell');
        shell.Run('http://localhost:3001');
        document.getElementById('status').innerHTML = 'Browser launched. You can close this window.';
    } catch (e) {
        document.getElementById('status').innerHTML = 'Could not launch automatically. Open http://localhost:3001 manually.';
    }
}
window.onload = function() { openBrowser(); };
</script>
</body>
</html>
