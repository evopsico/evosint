# Copy to .env and fill in what you have. Everything works without keys (fallbacks), keys just unlock richer data.
PORT=3001
CORS_ORIGIN=

# Optional enrichments
HIBP_API_KEY=
ABSTRACT_API_KEY=
GITHUB_TOKEN=
VIRUSTOTAL_API_KEY=
EMAILREP_KEY=           # EmailRep reputation (else skipped — unauth API disabled)

EVOSINT_USER_AGENT=Evosint/2.1
SESSION_SECRET=            # session signing key (auto-generated + persisted if empty)
TRUST_PROXY=               # set to 1 when behind cloudflared/nginx so visitors get real IPs (quotas + limits)
DISABLE_STRESS=            # set to 1 to disable the load tester on shared/public instances
EVO_ADMIN_USER=            # seed super-login (default evo, first boot only)
EVO_ADMIN_PASS=            # seed super-password (default set at first boot)

# Cloud deploys (Vercel): local files don't persist there, use KV instead.
STORE=                     # file (default, local) or vercel-kv (Vercel + connected KV database)
# KV_REST_API_URL=         # auto-injected by Vercel when you connect a KV database
# KV_REST_API_TOKEN=       # auto-injected by Vercel when you connect a KV database
